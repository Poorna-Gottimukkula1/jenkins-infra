pipeline {
    agent any
    
    parameters {
        // Source image tag
        string(
            name: 'BASE_IMAGE_TAG',
            defaultValue: 'latest-jdk17',
            description: 'Base image tag from jenkins/inbound-agent (default: latest-jdk17 for cron, can override for manual builds)'
        )
        
        // Destination image configuration
        string(
            name: 'DOCKER_REGISTRY',
            defaultValue: 'quay.io',
            description: 'Docker registry URL (e.g., quay.io, docker.io)'
        )
        string(
            name: 'DOCKER_REPO',
            defaultValue: 'pgottimu/jenkins-inbound-agent',
            description: 'Docker repository name (e.g., pgottimu/jenkins-inbound-agent)'
        )
        choice(
            name: 'TAG_STRATEGY',
            choices: ['date-tag', 'same-as-base', 'custom'],
            description: 'Tag strategy: date-tag (latest-jdk17-DDMMYYYY), same-as-base (use base tag), custom (specify below)'
        )
        string(
            name: 'CUSTOM_TAG',
            defaultValue: '',
            description: 'Custom tag (only used if TAG_STRATEGY is "custom")'
        )
        
        // Architecture options
        booleanParam(
            name: 'BUILD_AMD64',
            defaultValue: true,
            description: 'Build AMD64 architecture'
        )
        booleanParam(
            name: 'BUILD_PPC64LE',
            defaultValue: false,
            description: 'Build PPC64LE architecture (requires QEMU on AMD64 hosts)'
        )
        
        // Build options
        booleanParam(
            name: 'PUSH_TO_REGISTRY',
            defaultValue: false,
            description: 'Push images to registry'
        )
        booleanParam(
            name: 'BUILD_LATEST',
            defaultValue: false,
            description: 'Also tag as "latest"'
        )
    }
    
    environment {
        DOCKER_BUILDKIT = '1'
        BUILDX_NO_DEFAULT_ATTESTATIONS = '1'
        BASE_IMAGE_REPO = 'jenkins/inbound-agent'
    }
    
    stages {
        stage('Initialize') {
            steps {
                script {
                    // Construct full base image name
                    env.BASE_IMAGE = "${env.BASE_IMAGE_REPO}:${params.BASE_IMAGE_TAG}"
                    
                    // Determine the destination image tag based on strategy
                    def imageTag = ''
                    
                    if (params.TAG_STRATEGY == 'date-tag') {
                        // Generate date-based tag: latest-jdk17-DDMMYYYY
                        def dateTag = sh(
                            script: 'date +%d%m%Y',
                            returnStdout: true
                        ).trim()
                        imageTag = "${params.BASE_IMAGE_TAG}-${dateTag}"
                    } else if (params.TAG_STRATEGY == 'same-as-base') {
                        imageTag = params.BASE_IMAGE_TAG
                    } else {
                        // Use custom tag
                        imageTag = params.CUSTOM_TAG ?: 'latest'
                    }
                    
                    env.IMAGE_TAG = imageTag
                    env.FULL_IMAGE_NAME = "${params.DOCKER_REGISTRY}/${params.DOCKER_REPO}:${imageTag}"
                    env.FULL_IMAGE_NAME_AMD64 = "${params.DOCKER_REGISTRY}/${params.DOCKER_REPO}:${imageTag}-amd64"
                    env.FULL_IMAGE_NAME_PPC64LE = "${params.DOCKER_REGISTRY}/${params.DOCKER_REPO}:${imageTag}-ppc64le"
                    env.FULL_IMAGE_NAME_LATEST = "${params.DOCKER_REGISTRY}/${params.DOCKER_REPO}:latest"
                    
                    // Determine architectures to build
                    def archList = []
                    if (params.BUILD_AMD64) archList.add('AMD64')
                    if (params.BUILD_PPC64LE) archList.add('PPC64LE')
                    env.ARCHITECTURES = archList.join(', ')
                    
                    echo """
                    ========================================
                    Build Configuration:
                    ========================================
                    Base Image:        ${env.BASE_IMAGE}
                    Destination:       ${env.FULL_IMAGE_NAME}
                    Architectures:     ${env.ARCHITECTURES}
                    Tag Strategy:      ${params.TAG_STRATEGY}
                    Push to Registry:  ${params.PUSH_TO_REGISTRY}
                    Build Latest:      ${params.BUILD_LATEST}
                    ========================================
                    """
                    
                    if (!params.BUILD_AMD64 && !params.BUILD_PPC64LE) {
                        error("At least one architecture must be selected!")
                    }
                }
            }
        }
        
        stage('Setup Build Environment') {
            steps {
                script {
                    echo "Checking Docker..."
                    
                    sh '''
                        echo "=== Docker Version ==="
                        docker --version
                        
                        echo "=== System Architecture ==="
                        uname -m
                    '''
                    
                    echo "Build environment ready!"
                }
            }
        }
        
        stage('Build Individual Architecture Images') {
            parallel {
                stage('Build AMD64') {
                    when {
                        expression { params.BUILD_AMD64 }
                    }
                    steps {
                        script {
                            dir('images/jenkins-inbound-agent') {
                                echo "Building AMD64 image"
                                def amd64Tag = "${params.DOCKER_REGISTRY}/${params.DOCKER_REPO}:${env.IMAGE_TAG}-amd64"
                                
                                sh """
                                    DOCKER_BUILDKIT=0 docker build \
                                        --build-arg BASE_IMAGE=${env.BASE_IMAGE} \
                                        -f Dockerfile \
                                        -t ${amd64Tag} \
                                        .
                                """
                                
                                // Test AMD64 image
                                echo "Testing AMD64 image..."
                                sh """
                                    docker run --rm ${amd64Tag} java -version
                                    docker run --rm ${amd64Tag} python3 --version
                                    docker run --rm ${amd64Tag} ansible --version
                                """
                                
                                if (params.PUSH_TO_REGISTRY) {
                                    echo "Pushing AMD64 image..."
                                    sh "docker push ${amd64Tag}"
                                }
                            }
                        }
                    }
                }
                
                stage('Build PPC64LE') {
                    when {
                        expression { params.BUILD_PPC64LE }
                    }
                    steps {
                        script {
                            dir('images/jenkins-inbound-agent') {
                                echo "Building PPC64LE image"
                                def ppc64leTag = "${params.DOCKER_REGISTRY}/${params.DOCKER_REPO}:${env.IMAGE_TAG}-ppc64le"
                                
                                sh """
                                    DOCKER_BUILDKIT=0 docker build \
                                        --build-arg BASE_IMAGE=${env.BASE_IMAGE} \
                                        -f Dockerfile.ppc64le \
                                        -t ${ppc64leTag} \
                                        .
                                """
                                
                                // Test PPC64LE image
                                echo "Testing PPC64LE image..."
                                sh """
                                    docker run --rm ${ppc64leTag} java -version
                                    docker run --rm ${ppc64leTag} python3 --version
                                    docker run --rm ${ppc64leTag} ansible --version
                                """
                                
                                if (params.PUSH_TO_REGISTRY) {
                                    echo "Pushing PPC64LE image..."
                                    sh "docker push ${ppc64leTag}"
                                }
                            }
                        }
                    }
                }
            }
        }
        
        stage('Verify Images') {
            steps {
                script {
                    echo "Verifying built images"
                    sh '''
                        echo "=== Local Images ==="
                        docker images | grep jenkins-inbound-agent || true
                    '''
                    
                    if (params.PUSH_TO_REGISTRY) {
                        def pushMessage = """
                        ========================================
                        Images pushed successfully!
                        ========================================
                        """
                        
                        if (params.BUILD_AMD64) {
                            pushMessage += "AMD64:       ${env.FULL_IMAGE_NAME_AMD64}\n"
                        }
                        if (params.BUILD_PPC64LE) {
                            pushMessage += "PPC64LE:     ${env.FULL_IMAGE_NAME_PPC64LE}\n"
                        }
                        
                        pushMessage += """
                        ========================================
                        Pull commands:
                        """
                        
                        if (params.BUILD_AMD64) {
                            pushMessage += "podman pull ${env.FULL_IMAGE_NAME_AMD64}\n"
                        }
                        if (params.BUILD_PPC64LE) {
                            pushMessage += "podman pull ${env.FULL_IMAGE_NAME_PPC64LE}\n"
                        }
                        
                        pushMessage += "========================================"
                        
                        echo pushMessage
                    }
                }
            }
        }
    }
    
    post {
        success {
            script {
                def successMessage = """
                ========================================
                BUILD SUCCESSFUL!
                ========================================
                Base Image:    ${env.BASE_IMAGE}
                Architectures: ${env.ARCHITECTURES}
                Pushed:        ${params.PUSH_TO_REGISTRY}
                """
                
                if (params.BUILD_AMD64) {
                    successMessage += "AMD64 Image:   ${env.FULL_IMAGE_NAME_AMD64}\n"
                }
                if (params.BUILD_PPC64LE) {
                    successMessage += "PPC64LE Image: ${env.FULL_IMAGE_NAME_PPC64LE}\n"
                }
                
                if (!params.PUSH_TO_REGISTRY) {
                    successMessage += "\nNote: Images built locally only (not pushed to registry)\n"
                }
                
                successMessage += "========================================"
                
                echo successMessage
            }
        }
        failure {
            echo "Build failed. Check the logs for details."
        }
        cleanup {
            script {
                echo "Cleaning up workspace..."
                // Clean up built images if not pushing to registry
                if (!params.PUSH_TO_REGISTRY) {
                    sh '''
                        echo "Removing local images..."
                        docker rmi ${FULL_IMAGE_NAME_AMD64} 2>/dev/null || true
                        docker rmi ${FULL_IMAGE_NAME_PPC64LE} 2>/dev/null || true
                    '''
                }
                // Clean workspace
                cleanWs()
            }
        }
    }
}

