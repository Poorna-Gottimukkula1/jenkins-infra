                            script: """
                                cd ${WORKSPACE_DIR}
                                find tmp/kola/ -name "console.txt" -type f 2>/dev/null | head -1
                            """,
                            returnStdout: true
                        ).trim()
                        
                        if (originalConsole) {
                            consoleLog = sh(
                                script: "tail -30 ${WORKSPACE_DIR}/${originalConsole} | sed 's/\\x1b\\[[0-9;]*m//g' | sed 's/\\x1b\\[?[0-9;]*[a-zA-Z]//g'",
                                returnStdout: true
                            ).trim()
                        } else {
                            consoleLog = "Console log not found (test may not have started VM)"
                        }
                    }
                } catch (Exception e) {
                    consoleLog = "Error reading console log: ${e.message}"
                }
                
                def slackMessage = """
:x: *COSA Tests FAILED on ppc64le*

*Build*: #${BUILD_NUMBER}
*Mode*: ${params.BUILD_MODE}
*Tests Run*: ${testsRun.join(', ')}
*Branch*: ${params.FEDORA_COREOS_CONFIG_BRANCH}
*Build Version*: ${buildVersionDisplay}
*Job*: ${env.JOB_NAME}
*URL*: ${env.BUILD_URL}

*Last 30 lines of console log (if available):*
```
${consoleLog}
```

Full logs: ${env.BUILD_URL}artifact/
"""
                
                slackSend(
                    channel: '#fedora-coreos-ci-tests',
                    color: 'danger',
                    message: slackMessage,
                    sendAsText: true,
                    //tokenCredentialId: 'slack-token'
                )
            }
        }
        aborted {
            script {
                echo "========================================="
                echo "⚠️  COSA Tests ABORTED on ppc64le"
                echo "========================================="
                echo "Partial logs have been captured in artifacts"
                echo "Check archived artifacts for what was generated:"
                echo "- kola-test-output.log (partial)"
                echo "- kola-upgrade-output.log (partial)"
                echo "- console.txt (if test started)"
                echo "- journal.txt (if available)"
                
                // Read actual build ID
                def actualBuildId = ""
                if (fileExists("${WORKSPACE_DIR}/actual-build-id.txt")) {
                    actualBuildId = readFile("${WORKSPACE_DIR}/actual-build-id.txt").trim()
                }
                
                // Format build version display
                def buildVersionDisplay = ""
                if (params.BUILD_VERSION) {
                    buildVersionDisplay = params.BUILD_VERSION
                } else if (actualBuildId) {
                    buildVersionDisplay = "latest (${actualBuildId})"
                } else {
                    buildVersionDisplay = "latest"
                }
                
                // Build test list
                def testsRun = []
                if (params.RUN_KOLA_TESTS) testsRun.add("Kola: ${params.KOLA_TEST}")
                if (params.RUN_UPGRADE_TESTS) testsRun.add("Upgrade")
                if (params.RUN_EXTENDED_UPGRADE_TESTS) testsRun.add("Extended Upgrade (${params.TARGET_UPGRADE_STREAM})")
                
                // Get console log - check both test-results and original location
                def consoleLog = ""
                try {
                    // First try test-results (if Collect Results stage ran)
                    def consoleFile = "${WORKSPACE_DIR}/test-results/console.txt"
                    if (fileExists(consoleFile)) {
                        consoleLog = sh(
                            script: "tail -30 ${consoleFile} | sed 's/\\x1b\\[[0-9;]*m//g' | sed 's/\\x1b\\[?[0-9;]*[a-zA-Z]//g'",
                            returnStdout: true
                        ).trim()
                    } else {
                        // Try original location (if aborted before Collect Results)
                        def originalConsole = sh(
                            script: """
                                cd ${WORKSPACE_DIR}
                                find tmp/kola/ -name "console.txt" -type f 2>/dev/null | head -1
                            """,
                            returnStdout: true
                        ).trim()
                        
                        if (originalConsole) {
                            consoleLog = sh(
                                script: "tail -30 ${WORKSPACE_DIR}/${originalConsole} | sed 's/\\x1b\\[[0-9;]*m//g' | sed 's/\\x1b\\[?[0-9;]*[a-zA-Z]//g'",
                                returnStdout: true
                            ).trim()
                        } else {
                            consoleLog = "Console log not found (VM may not have started)"
                        }
                    }
                } catch (Exception e) {
                    consoleLog = "Error reading console log: ${e.message}"
                }
                
                def slackMessage = """
:warning: *COSA Tests ABORTED on ppc64le*

*Build*: #${BUILD_NUMBER}
*Mode*: ${params.BUILD_MODE}
*Tests Run*: ${testsRun.join(', ')}
*Branch*: ${params.FEDORA_COREOS_CONFIG_BRANCH}
*Build Version*: ${buildVersionDisplay}
*Job*: ${env.JOB_NAME}
*URL*: ${env.BUILD_URL}

*Reason*: Build was manually aborted or timed out

*Last 30 lines of console log (if available):*
```
${consoleLog}
```

Partial logs: ${env.BUILD_URL}artifact/
"""
                
                slackSend(
                    channel: '#fedora-coreos-ci-tests',
                    color: 'warning',
                    message: slackMessage,
                    sendAsText: true,
                    //tokenCredentialId: 'slack-token'
                )
            }
        }
        cleanup {
            cleanWs()
        }
    }
}