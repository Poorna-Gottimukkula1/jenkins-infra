pipeline {
    agent {
        kubernetes {
            inheritFrom 'jenkins-agent'
        }
    }
    
    triggers {
        // Daily at 11:00 AM IST (5:30 AM UTC)
        cron('30 5 * * *')
    }
    
    environment {
        // Credentials will be injected as environment variables
        IBMCLOUD_API_KEY = credentials('ibmcloud-api-key')
        SLACK_WEBHOOK_URL = credentials('slack-webhook-url')
        CIS_INSTANCE = credentials('cis-instance')
        CIS_DOMAIN_ID = credentials('cis-domain-id')
        GITHUB_TOKEN = credentials('GITHUB_TOKEN')
        
        // Script base URL (raw GitHub Enterprise format with subdirectory)
        SCRIPT_BASE_URL = 'https://raw.github.ibm.com/redstack-power/rh-ocp-ci-monitor/refs/heads/main/ocp-infra-diagnostics-and-automation'
    }
    
    options {
        timeout(time: 2, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
    }
    
    stages {
        stage('Download Scripts') {
            steps {
                script {
                    echo "Downloading scripts from GitHub Enterprise..."
                    sh """
                        mkdir -p cleanup-scripts
                        cd cleanup-scripts
                        
                        # Download scripts using curl with token authentication
                        curl -H "Authorization: token ${GITHUB_TOKEN}" \\
                             -H "Accept: application/vnd.github.v3.raw" \\
                             -o query_powervs_stale_resource.sh \\
                             -L "${SCRIPT_BASE_URL}/query_powervs_stale_resource_new.sh"
                        
                        curl -H "Authorization: token ${GITHUB_TOKEN}" \\
                             -H "Accept: application/vnd.github.v3.raw" \\
                             -o send_stale_resources_to_slack.sh \\
                             -L "${SCRIPT_BASE_URL}/send_stale_resources_to_slack.sh"
                        
                        echo "Scripts downloaded successfully"
                        ls -la *.sh
                    """
                }
            }
        }
        
        stage('Verify Prerequisites') {
            steps {
                script {
                    echo "Verifying required tools..."
                    sh '''
                        which bash || (echo "bash not found" && exit 1)
                        which curl || (echo "curl not found" && exit 1)
                        which jq || (echo "jq not found" && exit 1)
                        echo "All prerequisites satisfied"
                    '''
                }
            }
        }
        
        stage('Make Scripts Executable') {
            steps {
                script {
                    dir('cleanup-scripts') {
                        sh '''
                            chmod +x query_powervs_stale_resource.sh
                            chmod +x send_stale_resources_to_slack.sh
                            ls -la *.sh
                        '''
                    }
                }
            }
        }
        
        stage('Run Stale Resource Discovery') {
            steps {
                script {
                    echo "Running PowerVS stale resource discovery..."
                    dir('cleanup-scripts') {
                        sh """
                            ./query_powervs_stale_resource.sh \\
                                ibm_cloud_api_key=${IBMCLOUD_API_KEY} \\
                                cis-instance=${CIS_INSTANCE} \\
                                cis-domain-id=${CIS_DOMAIN_ID} \\
                                > stale_cleanup.log 2>&1
                            echo "Discovery completed. Log file created."
                        """
                    }
                }
            }
        }
        
        stage('Send Report to Slack') {
            steps {
                script {
                    echo "Sending stale resource report to Slack..."
                    dir('cleanup-scripts') {
                        sh """
                            chmod +x send_stale_resources_to_slack.sh
                            ./send_stale_resources_to_slack.sh stale_cleanup.log
                            echo "Slack notification sent."
                        """
                    }
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "Archiving logs..."
                // Archive from the workspace root, not inside dir()
                archiveArtifacts artifacts: 'cleanup-scripts/stale_cleanup.log',
                               allowEmptyArchive: true,
                               fingerprint: true
            }
        }
        success {
            echo "PowerVS stale resource cleanup job completed successfully!"
        }
        failure {
            echo "PowerVS stale resource cleanup job failed. Check logs for details."
        }
    }
}

