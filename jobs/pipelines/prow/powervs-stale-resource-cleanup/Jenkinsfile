pipeline {
    agent {
        kubernetes {
            inheritFrom 'jenkins-agent'
        }
    }
    
    triggers {
        // Daily at 11:00 AM IST (5:30 AM UTC)
        cron('30 5 * * *')
    }
    
    environment {
        // Credentials will be injected as environment variables
        IBMCLOUD_API_KEY = credentials('IBMCLOUD_PROD_API_PROW_KEY')
        //SLACK_WEBHOOK_URL = credentials('slack-webhook-url')
        //GITHUB_TOKEN = credentials('GITHUB_TOKEN')
        CIS_INSTANCE = "---"
        CIS_DOMAIN_ID = "----"
        // Script base URL (raw GitHub Enterprise format)
        SCRIPT_BASE_URL = 'https://raw.github.ibm.com/redstack-power/rh-ocp-ci-monitor/refs/heads/main/ocp-infra-diagnostics-and-automation'
        GITHUB_TOKEN = credentials('GITHUB_TOKEN')
    }
    
    options {
        timeout(time: 2, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '30'))
    }
    
    stages {
        stage('Download Scripts') {
            steps {
                script {
                    echo "Downloading scripts from GitHub Enterprise..."
                    sh '''
                        mkdir -p cleanup-scripts
                        cd cleanup-scripts
                        
                        # Download scripts using curl with token authentication
                        curl -H "Authorization: token ${GITHUB_TOKEN}" \
                             -H "Accept: application/vnd.github.v3.raw" \
                             -o query_powervs_stale_resource_new.sh \
                             -L "${SCRIPT_BASE_URL}/query_powervs_stale_resource_new.sh"
                        
                        echo "Scripts downloaded successfully"
                        ls -la *.sh
                    '''
                }
            }
        }
    
        
        stage('Run Stale Resource Discovery') {
            steps {
                script {
                    echo "Running PowerVS stale resource discovery in DEBUG mode..."
                    dir('cleanup-scripts') {
                        sh '''#!/bin/bash -x
                            set -x  # Enable debug mode
                            
                            echo "=== Starting stale resource discovery ==="
                            echo "Script: query_powervs_stale_resource_new.sh"
                            echo "Arguments: ibm_cloud_api_key=<REDACTED> cis-instance=${CIS_INSTANCE} cis-domain-id=${CIS_DOMAIN_ID}"
                            echo ""
                            chmod +x query_powervs_stale_resource_new.sh
                            # Run with debug output to both console and log file
                            ./query_powervs_stale_resource_new.sh \
                                ibm_cloud_api_key=${IBMCLOUD_API_KEY} \
                                cis-instance=${CIS_INSTANCE} \
                                cis-domain-id=${CIS_DOMAIN_ID} \
                                2>&1 | tee stale_cleanup.log
                            
                            echo ""
                            echo "=== Discovery completed. Log file created ==="
                            echo "Log file size: $(wc -l < stale_cleanup.log) lines"
                        '''
                    }
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "Archiving logs..."
                // Archive from the workspace root, not inside dir()
                archiveArtifacts artifacts: 'cleanup-scripts/stale_cleanup.log',
                               allowEmptyArchive: true,
                               fingerprint: true
            }
        }
        success {
            echo "PowerVS stale resource cleanup job completed successfully!"
        }
        failure {
            echo "PowerVS stale resource cleanup job failed. Check logs for details."
        }
    }
}